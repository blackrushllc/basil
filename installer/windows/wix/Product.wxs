<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Basil BASIC"
           Manufacturer="Blackrush LLC"
           Version="1.0.0"
           UpgradeCode="{F1C3EF7D-ABCD-4F11-9C77-111122223333}"
           ProductCode="*"
           Language="1033"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes"
           Platform="x64">

    <!-- Properties -->
    <Property Id="WHATNEWURL" Value="https://basilbasic.com/basil/" />
    <Property Id="ADD_EXAMPLES" Value="1" />
    <Property Id="EXAMPLESDIR" Value="[PersonalFolder]Basil\Examples" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open What's New after installation" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Directories -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="BasilRoot" Name="Basil">
        <Directory Id="BINFOLDER" Name="bin" />
        <Directory Id="DOCSFOLDER" Name="docs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="PersonalFolder">
      <Directory Id="BASIL_DOCS" Name="Basil">
        <Directory Id="EXAMPLESDIR" Name="Examples" />
      </Directory>
    </StandardDirectory>

    <!-- Icon for ARP (you can replace with .ico later if desired) -->
    <Icon Id="AppIcon" SourceFile="$(var.RepoRoot)\favicon.ico" />

    <!-- Features -->
    <Feature Id="Core" Title="Basil Core" Level="1" Absent="disallow">
      <ComponentGroupRef Id="BasilBinGroup" />
      <ComponentRef Id="PathEnvComponent" />
      <ComponentGroupRef Id="DocsGroup" />
    </Feature>

    <Feature Id="ExamplesFeature" Title="Examples and Guides" Level="1" AllowAbsent="yes">
      <Condition>ADD_EXAMPLES=1</Condition>
      <ComponentGroupRef Id="ExamplesGroup" />
    </Feature>

    <!-- Binaries -->
    <ComponentGroup Id="BasilBinGroup" Directory="BINFOLDER">
      <Component Id="BasilcComponent" Guid="{7B5C0955-3210-4AF1-8B08-444455556666}" Win64="yes">
        <File Id="basilc_exe" Source="$(var.BuildDir)\basilc.exe" KeyPath="yes" />
      </Component>
      <Component Id="BccComponent" Guid="{8C595A0E-4321-4C24-9FBA-777788889999}" Win64="yes">
        <File Id="bcc_exe" Source="$(var.BuildDir)\bcc.exe" KeyPath="yes" />
      </Component>
      <Component Id="BasilServeComponent" Guid="{9D6F6F2E-5432-49B8-98AA-AAAA0000BBBB}" Win64="yes">
        <File Id="basilserve_exe" Source="$(var.BuildDir)\basil-serve.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Add bin folder to system PATH -->
    <Component Id="PathEnvComponent" Guid="{2BAA1C00-19B7-4F1F-8D3F-CCCCDDDD0001}" Win64="yes" Directory="BINFOLDER">
      <Environment Id="BasilPath"
                   Name="PATH"
                   Action="set"
                   Part="last"
                   System="yes"
                   Permanent="no"
                   Value="[BINFOLDER]" />
      <CreateFolder />
      <RegistryValue Root="HKLM" Key="Software\Blackrush\Basil" Name="Installed" Value="1" Type="integer" KeyPath="yes"/>
    </Component>

    <!-- Harvested content groups (generated by the .wixproj) -->
    <Fragment>
      <!-- Docs harvested into DOCSFOLDER -->
      <ComponentGroup Id="DocsGroup" />
      <!-- Examples harvested into EXAMPLESDIR -->
      <ComponentGroup Id="ExamplesGroup" />
    </Fragment>

    <!-- UI: InstallDir + custom dialog for examples path -->
    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <Property Id="WIXUI_INSTALLDIR" Value="BasilRoot" />

      <DialogRef Id="CustomizeDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg">1</Publish>
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg">1</Publish>
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
    </UI>

    <!-- Customize dialog -->
    <Fragment>
      <UI>
        <Dialog Id="CustomizeDlg" Width="370" Height="270" Title="Basil – Examples">
          <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="15" Text="Examples and Guides" />
          <Control Id="Desc" Type="Text" X="15" Y="35" Width="340" Height="30"
                   Text="Optionally install example programs and guides. Choose the folder." />
          <Control Id="AddExamples" Type="CheckBox" X="15" Y="70" Width="300" Height="15"
                   Property="ADD_EXAMPLES" CheckBoxValue="1" Text="Install examples and guides" />

          <Control Id="ExamplesLabel" Type="Text" X="15" Y="95" Width="340" Height="15" Text="Examples folder:" />
          <Control Id="ExamplesPath" Type="PathEdit" X="15" Y="112" Width="260" Height="18" Property="EXAMPLESDIR" />
          <Control Id="Browse" Type="PushButton" X="280" Y="112" Width="75" Height="18" Text="Browse...">
            <Publish Event="DoAction" Value="BrowseExamples" />
          </Control>

          <Control Id="Back" Type="PushButton" X="180" Y="243" Width="75" Height="23" Text="&Back">
            <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
          </Control>
          <Control Id="Next" Type="PushButton" X="255" Y="243" Width="75" Height="23" Default="yes" Text="&Next">
            <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
          </Control>
          <Control Id="Cancel" Type="PushButton" X="90" Y="243" Width="75" Height="23" Cancel="yes" Text="Cancel">
            <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
          </Control>
        </Dialog>

        <Property Id="BROWSEFOLDER_PROP" />
        <CustomAction Id="BrowseExamples" Property="BROWSEFOLDER_PROP" Value="[EXAMPLESDIR]" />
        <Publish Dialog="CustomizeDlg" Control="Browse" Event="SetTargetPath" Value="EXAMPLESDIR">1</Publish>
      </UI>
    </Fragment>

    <!-- Launch What's New on completion -->
    <CustomAction Id="LaunchWhatsNew"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait">
      <CustomActionArgument>[WHATNEWURL]</CustomActionArgument>
    </CustomAction>

    <InstallExecuteSequence>
      <Custom Action="LaunchWhatsNew"
              After="InstallFinalize">WIXUI_EXITDIALOGOPTIONALCHECKBOX=1 AND NOT Installed</Custom>
    </InstallExecuteSequence>
  </Package>
</Wix>
