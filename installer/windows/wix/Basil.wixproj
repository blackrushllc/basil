<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputName>Basil</OutputName>
    <Platform>x64</Platform>
    <TargetFramework>net8.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>false</EnableDefaultItems>

    <!-- Passed in by the build script -->
    <DefineConstants>
      RepoRoot=$(RepoRoot);
      BuildDir=$(BuildDir);
      DocsStage=$(DocsStage);
      ExamplesStage=$(ExamplesStage)
    </DefineConstants>

    <!-- Suppress validation codes that correspond to per-user directories in a per-machine MSI -->
    <SuppressValidation>WIX0203;WIX0204</SuppressValidation>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
  </ItemGroup>

  <!-- Link WiX extensions explicitly to ensure resolver finds them -->
  <ItemGroup>
    <WixExtension Include="WixToolset.UI.wixext">
      <HintPath>$(NuGetPackageRoot)wixtoolset.ui.wixext\4.0.6\wixext4\WixToolset.UI.wixext.dll</HintPath>
    </WixExtension>
    <WixExtension Include="WixToolset.Util.wixext">
      <HintPath>$(NuGetPackageRoot)wixtoolset.util.wixext\4.0.6\wixext4\WixToolset.Util.wixext.dll</HintPath>
    </WixExtension>
  </ItemGroup>

  <!-- WiX v4 packages (extensions + Heat for harvest) -->
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.6" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
    <PackageReference Include="WixToolset.Heat" Version="4.0.6" />
  </ItemGroup>

  <!-- Suppress validation for per-user directories in per-machine install -->
  <ItemGroup>
    <SuppressIces Include="ICE38" />
    <SuppressIces Include="ICE64" />
  </ItemGroup>

  <!-- Remove harvests for docs/examples to avoid WIX0204 in v4; we'll provide external script instead -->

</Project>
