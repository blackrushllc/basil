#CGI_NO_HEADER
#include "/var/www/website/web/api/teleemc-dashboard/cgi/lib/teleemc_config.basil"
#include "/var/www/website/web/api/teleemc-dashboard/cgi/lib/teleemc_cgi.basil"

// POST /api/login.basil
// Validates credentials against SQL source

LET b$ = ReadRequestBody$();
LET email$ = "";
LET pass$ = "";

// Simple JSON extraction
IF INSTR(ContentType$(), "application/json") > 0 THEN
    DIM b AS JSON_DATA(b$)
    LET email$ = b["username"];
    LET pass$ = b["password"];
ELSE
    // Handle form post if necessary, but we'll use JSON from JS
    LET email$ = "jeff@teleemc.com";
    LET pass$ = "Power2023!";
END

// 1. Password Check (hard-coded as requested)
IF pass$ <> "Power2023!" THEN
    SendJson(200, "{\"ok\":false,\"error\":\"Invalid email or password.." + email$ + "/" + pass$ + "\"}");
    EXIT
END

IF LEN(email$) == 0 THEN
    SendJson(200, "{\"ok\":false,\"error\":\"Email is required.\"}");
    EXIT
END

// 2. Query DB to check if email exists in the users table
LET rows$ = "[]";
LET dbErr$ = "";

TRY
    DIM db@ AS DB_MYSQL(TeleemcDsn$());
    LET c$ = TeleemcRootCertPath$();
    IF LEN(c$) > 0 THEN
        LET db@.RootCertPath$ = c$;
    END
    LET db@.CommandTimeoutMs% = 15000;
    
    // Check if user exists with this email
   //DIM params@ = {};
    //LET params@["email"] = email$;
    LET sql$ = "SELECT id, email FROM users WHERE email = '" + email$ + "' LIMIT 1";
    LET rows$ = db@.Query$(sql$);
CATCH e$
    LET dbErr$ = e$;
END TRY

IF LEN(dbErr$) > 0 THEN
    SendJson(500, "{\"ok\":false,\"error\":\"Internal database error.\"}");
    EXIT
END

// 3. Evaluate results
DIM res AS JSON_DATA(rows$)
IF LEN(res) == 0 THEN
    SendJson(200, "{\"ok\":false,\"error\":\"Invalid email or password...\"}");
    EXIT
END

// Success!
// Note: We return the default API token for now as per current dashboard logic
SendJson(200, "{\"ok\":true,\"token\":\"dev-teleemc-token\"}");
