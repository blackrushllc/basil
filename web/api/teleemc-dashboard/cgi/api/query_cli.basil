#include "../lib/teleemc_config.basil"
#include "../lib/teleemc_cgi.basil"
#include "../lib/teleemc_sql_guard.basil"
#include "../lib/teleemc_ai_sql.basil"

PRINTLN "\nTeleEMC Query CLI Debug";
PRINTLN "\nThis tool reproduces /api/query logic without CGI/auth.";

// 1) Get prompt (ENV override, else interactive)
LET prompt$ = ENV$("QUESTION");
IF LEN(prompt$) == 0 THEN LET prompt$ = INPUT$("Enter query prompt: ");
IF LEN(prompt$) == 0 THEN
  PRINTLN "\n[ERROR] Prompt is required.";
  EXIT 1;
END

// 2) AI Plan
PRINTLN "\n[DEBUG] Generating AI SQL plan for prompt: ", prompt$;
IF LEN(ENV$("DEBUG_AI")) > 0 THEN
  LET sys$ = BuildSystemPrompt$();
  PRINTLN "\n[DEBUG] System Prompt: ", sys$;
END
PRINTLN "\n\nprompt---"
PRINTLN prompt$
PRINTLN "\n---"
LET plan$ = MakeSqlPlanJson$(prompt$);
PRINTLN "\n\nplan = MakeSqlPlanJson(prompt)---"
PRINTLN plan$
PRINTLN "\n---"
// Check if plan is blocked or errored
IF INSTR(plan$, "\"ok\":false") > 0 THEN
  PRINTLN "\n[ERROR] AI Plan returned an error: ", plan$;
  EXIT 2;
END
PRINTLN "\n\nplan=--"
PRINTLN plan$
PRINTLN "\n---"
LET err$ = ParseSqlPlanOrError$(plan$);
IF LEN(err$) > 0 THEN
  PRINTLN "\n[ERROR] AI Plan parsing failed: ", err$;
  EXIT 2;
END

// 3) Extract and Guardrails
DIM plan AS JSON_DATA(plan$)
LET sql$ = plan["sql"];
IF LEN(sql$) == 0 THEN
  PRINTLN "\n[ERROR] No SQL found in AI plan.";
  EXIT 3;
END
PRINTLN "\n[DEBUG] Generated SQL: ", sql$;

LET val$ = ValidateSqlOrError$(sql$);
IF LEN(val$) > 0 THEN
  PRINTLN "\n[ERROR] SQL Validation failed: ", val$;
  EXIT 3;
END

LET sql$ = EnforceSoftDeletes$(sql$);
LET sql$ = EnforceLimit$(sql$, TeleemcMaxRows%());
PRINTLN "\n[DEBUG] Final SQL: ", sql$;

// 4) Execute DB
PRINTLN "\n[DEBUG] Executing query against: ", TeleemcDsn$();
PRINTLN "\n";
LET rows$ = "[]";
LET dbErr$ = "";
TRY
  DIM db@ AS DB_MYSQL(TeleemcDsn$());
  LET c$ = TeleemcRootCertPath$();
  IF LEN(c$) > 0 THEN
      LET db@.RootCertPath$ = c$;
  END
  LET db@.CommandTimeoutMs% = 30000;
  LET params@ = plan["params"]
  PRINTLN "\nSQL:" + sql$;
  PRINTLN "\nPARAMS:" + params@;
  LET rows$ = db@.Query$(sql$, params@);
CATCH e$
  LET dbErr$ = e$ + "[" + sql$ + "]";
  LET rows$ = "[]";
END TRY

IF LEN(dbErr$) > 0 THEN
  PRINTLN "\n[ERROR] SQL execution failed: ", dbErr$;
  EXIT 4;
END

// 5) Artifact Persistence
LET aid$ = "A" + TRIM$(STR$(LEN(prompt$) + LEN(sql$)));
PRINTLN "\n[DEBUG] Creating artifact: ", aid$;
MKDIRS%(".basil/teleemc/artifacts/");
LET h% = FOPEN(".basil/teleemc/artifacts/" + aid$ + ".json", "w");
IF h% >= 0 THEN
  FWRITELN(h%, "{\"sql\":\"" + sql$ + "\",\"rows\":" + rows$ + "}");
  FCLOSE(h%);
  PRINTLN "\n[OK] Artifact saved to .basil/teleemc/artifacts/", aid$, ".json";
ELSE
  PRINTLN "\n[WARNING] Failed to save artifact file.";
END

// 6) Output result summary
PRINTLN "\n[DONE] Artifact ID: ", aid$;
PRINTLN "\nSQL Used: ", sql$;
IF LEN(rows$) > 200 THEN
  PRINTLN "\nRows returned (JSON preview): ", LEFT$(rows$, 200), "...";
ELSE
  PRINTLN "\nRows returned (JSON): ", rows$;
END
