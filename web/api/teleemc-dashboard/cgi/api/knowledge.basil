#CGI_NO_HEADER
#include "../lib/teleemc_config.basil"
#include "../lib/teleemc_cgi.basil"
#include "../lib/teleemc_auth.basil"

  // GET or POST /api/settings/knowledge
  // Manages the AI Onboarding knowledge sheet

  // 1) Auth
  IF RequireAuth%() == 0 THEN
      EmitAuthError();
      EXIT
  END

  LET method$ = ENV$("REQUEST_METHOD");

  IF method$ == "GET" THEN
      LET knowledge$ = TeleemcKnowledgeText$();
      LET k$ = REPLACE$("\n", "\\n", knowledge$);
      LET k$ = REPLACE$("\r", "", k$);
      LET k$ = REPLACE$("\"", "\\\"", k$);
      SendJson(200, "{\"ok\":true,\"knowledge\":\"" + k$ + "\"}");
      EXIT
  END

  IF method$ == "POST" THEN
      LET b$ = ReadRequestBody$();
      DIM body AS JSON_DATA(b$)
      LET knowledge$ = body["knowledge"];
      
      LET h% = FOPEN("/var/www/website/web/api/teleemc-dashboard/cgi/lib/teleemc_ai_knowledge.txt", "w");
      IF h% < 0 THEN
          SendJson(500, "{\"ok\":false,\"error\":\"file_error\"}");
          EXIT
      END
      FWRITELN(h%, knowledge$);
      FCLOSE(h%);
      
      SendJson(200, "{\"ok\":true}");
      EXIT
  END

  SendJson(405, "{\"ok\":false,\"error\":\"method_not_allowed\"}");
