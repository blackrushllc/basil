#include "../lib/teleemc_config.basil"
#include "../lib/teleemc_cgi.basil"

PRINTLN "TeleEMC Export CLI Debug";
PRINTLN "This tool reproduces /api/export logic without CGI/auth.";

// 1) Get inputs (ENV overrides, else interactive)
LET aid$ = ENV$("AID");
IF LEN(aid$) == 0 THEN LET aid$ = INPUT$("Enter artifact_id [A12345]: ");
IF LEN(aid$) == 0 THEN LET aid$ = "A12345";
LET f$ = ENV$("FORMAT");
IF LEN(f$) == 0 THEN LET f$ = INPUT$("Enter format [csv|txt] (default csv): ");
IF LEN(f$) == 0 THEN LET f$ = "csv";

// 2) Locate and read artifact file
LET path$ = ".basil/teleemc/artifacts/" + aid$ + ".json";
PRINTLN "[DEBUG] Using artifact path: ", path$;
LET h% = FOPEN(path$, "r");
IF h% < 0 THEN
  PRINTLN "[ERROR] Artifact not found: ", path$;
  EXIT 2;
END
LET art$ = FREAD$(h%, 1000000);
FCLOSE(h%);
PRINTLN "[DEBUG] Artifact size (bytes): ", LEN(art$);
DIM art AS JSON_DATA(art$)

// 3) Branch on format
IF f$ == "csv" THEN
  LET sql$ = art["sql"]; 
  IF LEN(sql$) == 0 THEN
    PRINTLN "[ERROR] No 'sql' key found in artifact JSON.";
    EXIT 3;
  END
  PRINTLN "[DEBUG] SQL: ", sql$;
  PRINTLN "[DEBUG] DSN: ", TeleemcDsn$();
  LET csv$ = "";
  LET dbErr$ = "";
  TRY
    DIM db@ AS DB_MYSQL(TeleemcDsn$());
    LET c$ = TeleemcRootCertPath$();
    IF LEN(c$) > 0 THEN
      LET db@.RootCertPath$ = c$;
    END
    LET db@.CommandTimeoutMs% = 30000;
    LET res@ = db@.QueryTable$(sql$);
    FOR EACH line$ IN res@
      LET csv$ = csv$ + line$ + "\n";
    NEXT
  CATCH e$
    LET dbErr$ = e$;
  END TRY
  IF LEN(dbErr$) > 0 THEN
    PRINTLN "[ERROR] SQL execution failed: ", dbErr$;
    EXIT 4;
  END
  PRINTLN "[OK] Query succeeded. CSV output follows:";
  PRINT csv$;
ELSE IF f$ == "txt" THEN
  LET sql$ = art["sql"];
  PRINTLN "Artifact: ", aid$;
  PRINTLN "SQL: ", sql$;
ELSE
  PRINTLN "[ERROR] Unsupported format: ", f$;
  EXIT 5;
END

PRINTLN "\n[DONE]";
