REM TeleEMC SQL Guard Library

FUNC NormalizeSql$(sql$)

    //PRINTLN "NormalizeSql:"
    //PRINTLN sql$

    LET s$ = TRIM$(sql$);
    WHILE INSTR(s$, "  ") > 0
        LET s$ = REPLACE$("  ", " ", s$);
    END
    IF RIGHT$(s$, 1) == ";" THEN
        LET s$ = LEFT$(s$, LEN(s$) - 1);
    END
    RETURN s$;
END

FUNC IsSingleStatement%(sql$)
    LET s$ = " " + sql$
    IF INSTR(s$, ";") > 0 THEN RETURN 0;
    IF INSTR(s$, "--") > 0 THEN RETURN 0;
    IF INSTR(s$, "/*") > 0 THEN RETURN 0;
    RETURN 1;
END

FUNC IsReadOnlySql%(sql$)

    //PRINTLN "IsReadOnlySql:"
    //PRINTLN sql$

    LET s$ = UCASE$(NormalizeSql$(sql$));
    IF LEFT$(s$, 6) != "SELECT" AND LEFT$(s$, 4) != "WITH" THEN RETURN 0;
    LET f$ = "INSERT,UPDATE,DELETE,DROP,ALTER,CREATE,TRUNCATE,GRANT,REVOKE,REPLACE,CALL,EXECUTE,PREPARE,DEALLOCATE,INTO OUTFILE,LOAD_FILE,INFORMATION_SCHEMA,MYSQL.";
    LET k$ = SPLIT$(f$, ",");
    LET padded$ = " " + s$ + " ";
    FOR EACH item$ IN k$
        IF INSTR(padded$, " " + item$ + " ") > 0 THEN RETURN 0;
    NEXT
    RETURN 1;
END

FUNC ContainsSensitiveCols%(sql$)
    LET s$ = " " + LCASE$(sql$);
    LET b$ = "ecw_password,ecw_username,gmail_password,gmail_username,apple_password,apple_id,remember_token";
    LET c$ = SPLIT$(b$, ",");
    FOR EACH item$ IN c$
        IF INSTR(s$, item$) > 0 THEN RETURN 1;
    NEXT
    LET p$ = "password,passwd,secret,token,api_key,credential";
    LET pat$ = SPLIT$(p$, ",");
    FOR EACH item$ IN pat$
        IF INSTR(s$, item$) > 0 THEN RETURN 1;
    NEXT
    RETURN 0;
END

FUNC RejectSelectStar%(sql$)

    //PRINTLN "RejectSelectStar:"
    //PRINTLN sql$

    LET s$ = " " + UCASE$(NormalizeSql$(sql$));
    IF INSTR(s$, "SELECT *") > 0 THEN RETURN 1;
    IF INSTR(s$, "SELECT  *") > 0 THEN RETURN 1;
    RETURN 0;
END

