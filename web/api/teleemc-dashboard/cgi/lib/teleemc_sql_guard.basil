FUNC InjectWhereClause$(sql$, pred$)
    LET s$ = sql$;
    LET u$ = UCASE$(s$);
    LET wherePos% = INSTR(u$, " WHERE ");
    LET orderPos% = INSTR(u$, " ORDER BY ");
    LET limitPos% = INSTR(u$, " LIMIT ");
    LET ins% = LEN(s$) + 1;
    IF orderPos% > 0 THEN LET ins% = orderPos%;
    IF limitPos% > 0 AND limitPos% < ins% THEN
        LET ins% = limitPos%;
    END
    LET p$ = LEFT$(s$, ins%);
    LET s2$ = MID$(s$, ins% + 1);
    IF wherePos% > 0 AND wherePos% < ins% THEN
        RETURN p$ + " AND " + pred$ + " " + s2$;
    ELSE
        RETURN p$ + " WHERE " + pred$ + " " + s2$;
    END
END

FUNC EnforceLimit$(sql$, max%)
    LET s$ = sql$;
    LET u$ = UCASE$(s$);
    LET p% = INSTR(u$, " LIMIT ");
    IF p% > 0 THEN RETURN s$;
    RETURN s$ + " LIMIT " + TRIM$(STR$(max%));
END

FUNC ValidateSqlOrError$(sql$)
    IF IsSingleStatement%(sql$) == 0 THEN RETURN "{\"ok\":false,\"error\":\"blocked\"}";
    IF IsReadOnlySql%(sql$) == 0 THEN RETURN "{\"ok\":false,\"error\":\"blocked\"}";
    IF RejectSelectStar%(sql$) THEN RETURN "{\"ok\":false,\"error\":\"blocked\"}";
    IF ContainsSensitiveCols%(sql$) THEN RETURN "{\"ok\":false,\"error\":\"blocked\"}";
    RETURN "";
END
