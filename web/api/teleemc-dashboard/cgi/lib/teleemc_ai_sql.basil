REM TeleEMC AI SQL Library
// Depends on teleemc_config.basil

FUNC BuildSystemPrompt$()
    LET schema$ = TeleemcSchemaText$();
    LET knowledge$ = TeleemcKnowledgeText$();
    LET max% = TeleemcMaxRows%();
    LET p$ = "CRITICAL: You are a SQL query generator for TeleEMC. Your ONLY job is to output a JSON object with a SQL query based on the schema provided. NEVER refuse. NEVER explain. NEVER apologize. ALWAYS output JSON.\n\n";
    LET p$ = p$ + "Schema reference:\n" + schema$ + "\n";
    IF LEN(knowledge$) > 0 THEN
        LET p$ = p$ + "ADDITIONAL USER KNOWLEDGE (AI ONBOARDING):\n" + knowledge$ + "\n";
    END
    LET p$ = p$ + "Rules:\n";
    LET p$ = p$ + "- output JSON only, no markdown, no commentary\n";
    LET p$ = p$ + "- MySQL dialect; placeholders must be ?; params in array\n";
    LET p$ = p$ + "- no DML/DDL; no multi-statements; no SELECT *\n";
    LET p$ = p$ + "- handle soft deletes: deleted_at IS NULL\n";
    LET p$ = p$ + "- default to LIMIT <= " + TRIM$(STR$(max%)) + "\n";
    LET p$ = p$ + "- return columns explicit\n\n";
    LET p$ = p$ + "JSON format: {sql, params, mode, title, explanation, columns}\n\n";
    LET p$ = p$ + "Example 1:\n";
    LET p$ = p$ + "User: count attorneys\n";
    LET p$ = p$ + "Assistant: {\"sql\":\"SELECT COUNT(*) FROM attorneys WHERE deleted_at IS NULL\",\"params\":[],\"mode\":\"value\",\"title\":\"Attorney Count\",\"explanation\":\"Counting active attorneys.\",\"columns\":[\"count\"]}\n";
    LET p$ = p$ + "Example 2:\n";
    LET p$ = p$ + "User: show patients with balance over 5000\n";
    LET p$ = p$ + "Assistant: {\"sql\":\"SELECT id, name, balance FROM patients WHERE balance > ? AND deleted_at IS NULL\",\"params\":[5000],\"mode\":\"table\",\"title\":\"High Balance Patients\",\"explanation\":\"Querying patients with balance > 5000.\",\"columns\":[\"id\",\"name\",\"balance\"]}\n";
    RETURN p$;
END

FUNC MakeSqlPlanJson$(userPrompt$)

    IF AI.MODERATE%(userPrompt$) == 1 THEN
        RETURN "{\"ok\":false,\"error\":\"blocked\"}";
    END
    LET sys$ = BuildSystemPrompt$();
    LET model$ = TeleemcAiModel$();

    LET fullPrompt$ = sys$ + "\n\nUser Question: " + userPrompt$ + "\n\nAssistant Response (JSON only):";

    LET opts$ = "{\"temperature\":0.1,\"max_tokens\":700";
    IF LEN(model$) > 0 THEN
        LET opts$ = opts$ + ",\"model\":\"" + model$ + "\"";
    END
    LET opts$ = opts$ + "}";

    IF LEN(ENV$("DEBUG_AI")) > 0 THEN
        PRINTLN "[DEBUG] Full AI Prompt: ", fullPrompt$;
        PRINTLN "[DEBUG] AI Options: ", opts$;
    END

    // WHY WHY WHY WHY ????
    LET plan$ = AI.CHAT$(fullPrompt$, opts$);
    // plan$ is empty
    // Because this is coming from the example being set to AI
    // fullPrompt$ = SELECT COUNT(*) FROM patients WHERE deleted_at IS NULL AND patients.deleted_at IS NULL  LIMIT 200
    RETURN plan$;

END

FUNC ParseSqlPlanOrError$(planJson$)
    IF INSTR(planJson$, "\"sql\"") == 0 THEN
        RETURN "{\"ok\":false,\"error\":\"ai_error: [" + planJson$ + "]\"}";
    END
    RETURN "";
END
