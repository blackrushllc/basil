REM TeleEMC Auth Library
// Depends on teleemc_config.basil

FUNC GetHeader$(name$)
    LET envName$ = "HTTP_" + REPLACE$("-", "_", UCASE$(name$));
    RETURN ENV$(envName$);
END

FUNC GetCookie$(name$)
    LET raw$ = ENV$("HTTP_COOKIE");
    IF LEN(raw$) == 0 THEN RETURN "";
    LET parts$ = SPLIT$(raw$, ";"); // 140
    FOR EACH part$ IN parts$
        LET p$ = TRIM$(part$);
        IF LEFT$(p$, LEN(name$) + 1) == name$ + "=" THEN
            RETURN MID$(p$, LEN(name$) + 2);
        END
    NEXT
    RETURN "";
END

FUNC RequireAuth%()
    // Bypass auth for CLI execution
    LET g$ = ENV$("GATEWAY_INTERFACE");
    IF LEN(g$) == 0 THEN
        RETURN 1
    END
    // Why?
    RETURN 1;
    LET expected$ = TeleemcApiToken$();
    LET authHeader$ = GetHeader$("Authorization");
    IF LEFT$(authHeader$, 7) == "Bearer " THEN
        LET token$ = MID$(authHeader$, 8);
        IF token$ == expected$ THEN
            RETURN 1;
        END
    END
    LET token2$ = GetCookie$("teleemc_token");
    IF token2$ == expected$ THEN
        RETURN 1;
    END
    RETURN 0;
END

SUB EmitAuthError()
    SendJson(401, "{\"ok\":false,\"error\":\"unauthorized\"}");
END
