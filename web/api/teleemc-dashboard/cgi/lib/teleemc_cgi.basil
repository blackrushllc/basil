REM TeleEMC CGI Library

LET b% = LOADENV%('env.txt')

FUNC ReadRequestBody$()
REM    LET len$ = ENV$("CONTENT_LENGTH");
REM    IF LEN(len$) == 0 THEN
REM        RETURN "";
REM    END
REM    LET l% = VAL(len$);
REM    IF l% <= 0 THEN
REM        RETURN "";
REM    END
    RETURN REQUEST_BODY$();
END

FUNC ContentType$()
    RETURN ENV$("CONTENT_TYPE");
END

SUB SendJson(status%, json$)
    PRINT "Status: ", status%, "\r\n";
    PRINT "Content-Type: application/json\r\n";
    PRINT "Cache-Control: no-cache, no-store, must-revalidate\r\n\r\n";
    PRINT json$;
END

SUB SendText(status%, contentType$, text$)
    PRINT "Status: ", status%, "\r\n";
    PRINT "Content-Type: ", contentType$, "\r\n\r\n";
    PRINT text$;
END

SUB SendDownload(status%, contentType$, filename$, bytes$)
    PRINT "Status: ", status%, "\r\n";
    PRINT "Content-Type: ", contentType$, "\r\n";
    PRINT "Content-Disposition: attachment; filename=\"", filename$, "\"\r\n\r\n";
    PRINT bytes$;
END

FUNC JsonGetString$(json$, key$)
    DIM j AS JSON_DATA(json$)
    RETURN j[key$]
END

FUNC JsonGetInt%(json$, key$, default%)
    DIM j AS JSON_DATA(json$)
    LET v = j[key$]
    IF LEN(STR$(v)) == 0 THEN RETURN default%
    RETURN v
END

FUNC JsonGetList(json$, key$)
    DIM j AS JSON_DATA(json$)
    RETURN j[key$]
END
