REM TeleEMC Config Library

FUNC EnvOr$(key$, fallback$)
    LET val$ = ENV$(key$);
    IF LEN(val$) == 0 THEN
        RETURN fallback$;
    END
    RETURN val$;
END

FUNC TeleemcDsn$()
    RETURN EnvOr$("TELEEMC_DSN", "mysql://admin:yhj1Sz39RYkjAlQNBRv3@restored.ctvnyr2rbvwc.us-east-1.rds.amazonaws.com:3306/slim?ssl-mode=DISABLED");
END

FUNC TeleemcRootCertPath$()
    RETURN ENV$("TELEEMC_RDS_CA_PATH");
END

FUNC TeleemcMaxRows%()
    LET val$ = ENV$("TELEEMC_MAX_ROWS");
    LET m% = 0;
    IF LEN(val$) == 0 THEN
        LET m% = 200;
    ELSE
        LET m% = VAL(val$);
    END
    IF m% > 1000 THEN
        LET m% = 1000;
    END
    IF m% < 1 THEN
        LET m% = 1;
    END
    RETURN m%;
END

FUNC TeleemcApiToken$()
    RETURN EnvOr$("TELEEMC_API_TOKEN", "dev-teleemc-token");
END

FUNC TeleemcSchemaText$()
    LET path$ = "/var/www/website/web/api/teleemc-dashboard/docs/TELEEMC_SCHEMA_QUICKREF.md"
    LET h% = FOPEN(path$, "r")
    IF h% < 0 THEN
        LET path$ = "../../docs/TELEEMC_SCHEMA_QUICKREF.md"
        LET h% = FOPEN(path$, "r")
    END
    IF h% < 0 THEN RETURN ""
    LET schema$ = FREAD$(h%, 10000)
    FCLOSE(h%)
    RETURN schema$
END

FUNC TeleemcKnowledgeText$()
    LET path$ = "/var/www/website/web/api/teleemc-dashboard/cgi/lib/teleemc_ai_knowledge.txt"
    LET h% = FOPEN(path$, "r")
    IF h% < 0 THEN RETURN ""
    LET txt$ = FREAD$(h%, 10000)
    FCLOSE(h%)
    RETURN txt$
END

FUNC TeleemcAiModel$()
    RETURN EnvOr$("TELEEMC_AI_MODEL", "");
END
