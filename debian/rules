#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS=hardening=+all
%:
	dh $@ --buildsystem=cargo

override_dh_auto_build:
	# basilc needs --features obj-all
	dh_auto_build -- --locked --offline -p basilc --release --features obj-all
	cargo build --locked --offline -p bcc --release
	cargo build --locked --offline -p basil-serve --release

override_dh_auto_install:
	install -D -m 0755 target/release/basilc      debian/basil/usr/bin/basilc
	install -D -m 0755 target/release/bcc         debian/basil/usr/bin/bcc
	install -D -m 0755 target/release/basil-serve debian/basil/usr/bin/basil-serve
	# (docs/examples as you already had)

	# Docs (/usr/share/doc/basil)
	install -d debian/basil/usr/share/doc/basil
	# Copy docs/**, README.md, WHATS_NEW.md
	rsync -a --delete docs/ debian/basil/usr/share/doc/basil/docs/
	install -m644 README.md WHATS_NEW.md debian/basil/usr/share/doc/basil/

	# Examples → Debian policy prefers /usr/share/doc/<pkg>/examples
	# We stage with excludes: *.basilx, .env, dot/underscore, .basilcache
	EXDST=debian/basil/usr/share/doc/basil/examples ; \
	mkdir -p "$$EXDST" ; \
	rsync -a examples/ "$$EXDST"/ \
	  --exclude="*.basilx" \
	  --exclude=".env" \
	  --exclude=".*" \
	  --exclude="_*" \
	  --exclude="basilbasic.com/.basilcache"

# Lint: don't fail on missing manpages (optional)
override_dh_missing:
	dh_missing --list-missing
